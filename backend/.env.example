# 通义千问 DashScope API Key（必填，https://bailian.console.aliyun.com 获取）
DASHSCOPE_API_KEY=sk-your-key-here

# 模型配置（可选，默认即可）
MODEL_TEXT=qwen-plus
MODEL_VL=qwen3-vl-plus
MODEL_EMBEDDING=qwen3.7-text-embedding-flash

# JWT 密钥（生产环境务必修改）
JWT_SECRET=please-change-this-secret
JWT_EXPIRE_HOURS=72

# 政策文档解析：api（MinerU 官方托管 API，按页计费）/ local（本地部署，暂未实现）
MINERU_MODE=api
# MinerU API Token（解析 PDF 必填，https://mineru.net 注册申请；docx/txt 不需要）
MINERU_API_TOKEN=
# MinerU 模型版本：pipeline / vlm（推荐 vlm，复杂版式效果更好）
MINERU_MODEL_VERSION=vlm
